--=====================================================================
-- MASTER CONTROLLER  (run this on the ADVANCED WIRELESS COMPUTER)
--=====================================================================

local MODEM_SIDE = "back"
local PROTOCOL   = "COPPERNET"
local TIMEOUT    = 6      -- seconds without telemetry before "signal lost"

if peripheral.getType(MODEM_SIDE) ~= "modem" then
    for _, side in ipairs({ "back", "top", "left", "right", "bottom", "front" }) do
        if peripheral.getType(side) == "modem" then MODEM_SIDE = side break end
    end
end
rednet.open(MODEM_SIDE)

local W, H   = term.getSize()
local COLOUR = term.isColour and term.isColour()

--------------------------- DRAW PRIMITIVES ---------------------------
-- Every line is clipped to the terminal width, so a full-width row can
-- never wrap onto the next one (the old "one character too wide" bug).
local function setCol(fg, bg)
    if COLOUR then
        term.setTextColour(fg or colours.white)
        term.setBackgroundColour(bg or colours.black)
    end
end

local function put(y, text, fg, bg)
    if y < 1 or y > H then return end
    setCol(fg, bg)
    term.setCursorPos(1, y)
    term.clearLine()
    term.write(string.sub(text, 1, W))
    setCol()
end

local function rule(y, fg)
    put(y, string.rep("-", W), fg or colours.grey)
end

local function field(y, label, value, fg)
    put(y, string.format(" %-8s %s", label, tostring(value)), fg)
end

-- width includes the surrounding brackets; clamped so it can never
-- draw past the right edge of a narrow (pocket computer) screen.
local function bar(x, y, width, frac, fg)
    frac  = math.max(0, math.min(1, frac or 0))
    width = math.max(2, math.min(width, W - x + 1))
    local inner  = width - 2
    local filled = math.floor(inner * frac + 0.5)
    term.setCursorPos(x, y)
    setCol(colours.grey)
    term.write("[")
    setCol(fg or colours.lime)
    term.write(string.rep("=", filled))
    setCol(colours.grey)
    term.write(string.rep(".", inner - filled) .. "]")
    setCol()
end

------------------------------- SETUP UI ------------------------------
local function ask(prompt, default)
    setCol(colours.white)
    term.write(string.sub(prompt, 1, W - 1))
    setCol(colours.yellow)
    local answer = read()
    setCol()
    if answer == "" then return default end
    return answer
end

term.clear()
put(1, " CC COPPER MINING CONTROLLER", colours.orange)
rule(2)
term.setCursorPos(1, 4)

local turtleID = tonumber(ask(" Turtle ID          : "))
if not turtleID then
    put(6, " Invalid turtle ID.", colours.red)
    term.setCursorPos(1, 8)
    return
end

local startY  = tonumber(ask(" Turtle Y level     : ", "64")) or 64
local targetY = tonumber(ask(" Mining Y level [48]: ", "48")) or 48
local length  = tonumber(ask(" Room length [20]   : ", "20")) or 20
local width   = tonumber(ask(" Room width [5]     : ", "5")) or 5

local FACING = { north = 0, east = 1, south = 2, west = 3 }
local facingName = string.lower(ask(" Facing [north]     : ", "north"))
local facing = FACING[facingName] or 0

rednet.send(turtleID, {
    command = "START_MINE",
    startY  = startY,
    targetY = targetY,
    length  = length,
    width   = width,
    facing  = facing,
}, PROTOCOL)

------------------------------ DASHBOARD ------------------------------
local SPIN  = { "|", "/", "-", "\\" }
local PICK  = { ">-", "->", ">=", "=>" }
local TRACK = { "o0o", "0o0" }

local frame    = 0
local lastSeen = os.clock()
local finished = false
local t = {
    status = "Waiting", detail = "no telemetry yet",
    x = 0, y = startY, z = 0, facing = facingName,
    home = { x = 0, y = startY, z = 0 }, distHome = 0,
    fuel = 0, fuelMax = 0, copper = 0, ores = 0, slots = 0,
    moved = 0, progress = 0, progressMax = length * width,
    row = 0, rows = width, gps = false,
}

local function statusColour(s)
    if s == "FINISHED" or s == "HOME" then return colours.lime end
    if s == "ABORTED" or s == "BLOCKED" or s == "LOW FUEL" or s == "LINK LOST" then
        return colours.red
    end
    if s == "RETURNING HOME" or s == "RECALLED" or s == "FULL" then return colours.orange end
    if s == "Vein mining" then return colours.yellow end
    return colours.white
end

local function draw()
    W, H = term.getSize()  -- pocket computer / tablet screens can change size
    local live   = (os.clock() - lastSeen) < TIMEOUT
    local spin   = SPIN[(frame % #SPIN) + 1]
    local header = " COPPER MINER  #" .. turtleID
    put(1, header .. string.rep(" ", math.max(1, W - #header - 1)) .. spin, colours.orange)
    rule(2)

    field(3, "STATUS", string.sub(t.status .. " - " .. (t.detail or ""), 1, W - 11),
        statusColour(t.status))
    field(4, "POS", string.format("%d, %d, %d  facing %s",
        t.x, t.y, t.z, t.facing or "?"), colours.lightBlue)
    field(5, "HOME", string.format("%d, %d, %d  (%d away)",
        t.home.x, t.home.y, t.home.z, t.distHome or 0), colours.cyan)

    -- barW shrinks to whatever room is left after the label and text
    -- columns, so textX never lands inside the bar on narrow (pocket
    -- computer / tablet) screens.
    local barX  = 10
    local barW  = math.max(4, math.min(18, W - barX - 10))
    local textX = barX + barW + 1

    -- Fuel gauge
    local fuelFrac, fuelText
    if t.fuel == -1 then
        fuelFrac, fuelText = 1, "unlimited"
    else
        local ceiling = (t.fuelMax and t.fuelMax > 0) and t.fuelMax or math.max(t.fuel, 1)
        fuelFrac, fuelText = t.fuel / ceiling, tostring(t.fuel)
    end
    local fuelCol = (fuelFrac < 0.15) and colours.red
        or (fuelFrac < 0.35) and colours.orange or colours.lime
    put(6, " FUEL")
    bar(barX, 6, barW, fuelFrac, fuelCol)
    term.setCursorPos(textX, 6)
    setCol(fuelCol); term.write(string.sub(fuelText, 1, W - textX)); setCol()

    -- Pattern progress
    local pmax  = math.max(1, t.progressMax or (length * width))
    local pfrac = (t.progress or 0) / pmax
    put(7, " DIG")
    bar(barX, 7, barW, pfrac, colours.yellow)
    term.setCursorPos(textX, 7)
    setCol(colours.yellow)
    term.write(string.sub((t.progress or 0) .. "/" .. pmax, 1, W - textX))
    setCol()

    field(8, "LANE", string.format("%d of %d   room %d x %d",
        t.row or 0, t.rows or width, width, length), colours.yellow)
    field(9, "HAUL", string.format("Cu %d  ore %d  slots %d/16",
        t.copper or 0, t.ores or 0, t.slots or 0), colours.orange)
    field(10, "TRAVEL", string.format("%d moved  GPS %s",
        t.moved or 0, t.gps and "lock" or "dead-reckon"), colours.lightGrey)

    rule(11)

    -- Mining animation
    local pick  = PICK[(frame % #PICK) + 1]
    local track = TRACK[(math.floor(frame / 2) % #TRACK) + 1]
    local trail = string.rep("#", math.floor(pfrac * math.max(0, W - 10)))
    put(12, "  " .. track .. pick .. trail, colours.brown)

    rule(13)

    if live then
        put(14, " LINK   online", colours.lime)
    else
        put(14, " LINK   SIGNAL LOST - turtle auto-returns home", colours.red)
    end
    put(15, " Ender modem or repeaters extend telemetry range.", colours.grey)

    rule(H - 1)
    put(H, " R=recall  A=abort  Q=quit", colours.lightGrey)
end

term.clear()
draw()

local timer = os.startTimer(0.25)
while true do
    local event, p1, p2, p3 = os.pullEvent()

    if event == "timer" and p1 == timer then
        frame = frame + 1
        -- Heartbeat: silence for too long tells the turtle to come home.
        if frame % 4 == 0 then
            rednet.send(turtleID, { command = "PING" }, PROTOCOL)
        end
        draw()
        timer = os.startTimer(0.25)

    elseif event == "rednet_message" then
        local sender, msg, proto = p1, p2, p3
        if proto == PROTOCOL and sender == turtleID and type(msg) == "table"
           and msg.kind == "TELEMETRY" then
            t = msg
            t.home = t.home or { x = 0, y = 0, z = 0 }
            lastSeen = os.clock()
            if msg.status == "FINISHED" then finished = true end
            draw()
            if finished then
                put(H, " Job complete - press Q to quit.", colours.lime)
            end
        end

    elseif event == "key" then
        if p1 == keys.r then
            rednet.send(turtleID, { command = "RECALL" }, PROTOCOL)
            t.detail = "recall sent"
        elseif p1 == keys.a then
            rednet.send(turtleID, { command = "ABORT" }, PROTOCOL)
            t.detail = "abort sent"
        elseif p1 == keys.q then
            break
        end
        draw()
    end
end

setCol()
term.clear()
term.setCursorPos(1, 1)
print("Controller stopped.")
