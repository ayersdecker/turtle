-- CONFIGURATION
local MODEM_SIDE = "back" -- Change to "left", "right", "back", "bottom" if needed

rednet.open(MODEM_SIDE)

term.clear()
term.setCursorPos(1,1)
print("=== CC MASTER CONTROLLER ===")
print("----------------------------")

write("Enter Turtle's ID Number: ")
local turtleID = tonumber(read())

write("Enter Turtle's Current Y-Level: ")
local startY = tonumber(read())

write("Enter Blocks Forward to Mine: ")
local distance = tonumber(read()) or 20

if not turtleID or not startY then
    print("\nError: Invalid ID or Y-Level.")
    return
end

-- Package data
local payload = {
    command = "START_MINE",
    startY = startY,
    dist = distance
}

print("\nBroadcasting signal to airwaves...")
-- Converts the table to a string and broadcasts it to reach the turtle
rednet.broadcast(textutils.serialize(payload))

-- Dynamic Status Dashboard
term.clear()
while true do
    -- Listens for incoming status broadcast packages
    local senderID, rawReply = rednet.receive(5) 
    local reply = textutils.unserialize(rawReply)
    
    if not senderID then
        term.setCursorPos(1,5)
        print("Status: [CONNECTION TIMEOUT / IDLE]")
    elseif type(reply) == "table" then
        term.clear()
        term.setCursorPos(1,1)
        print("=== LIVE TURTLE TRACKING ===")
        print("----------------------------")
        print("Connected to Turtle ID : " .. turtleID)
        print("Current Turtle Altitude: Y = " .. (reply.yLevel or "Unknown"))
        print("Current Operation      : " .. (reply.status or "Waiting"))
        print("----------------------------")
        
        if reply.status == "FINISHED" then
            print("\nOperation completed successfully!")
            break
        end
    end
    os.sleep(0.2)
end
