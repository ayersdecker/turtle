--=====================================================================
-- COPPER MINING NODE  (run this on the ADVANCED TURTLE)
--=====================================================================

--------------------------- CONFIGURATION ----------------------------
local MODEM_SIDE   = "right"   -- turtle modem side
local PROTOCOL     = "COPPERNET"
local DEFAULT_Y    = 48        -- best copper layer if none supplied
local FUEL_RESERVE = 48        -- extra fuel kept on top of the trip home
local MAX_VEIN     = 64        -- max blocks followed in one copper vein
local DIG_RETRIES  = 8         -- give up instead of looping on bedrock
local REPORT_RATE  = 0.4       -- seconds between telemetry packets

----------------------------- ITEM TABLES -----------------------------
local COPPER = {
    ["minecraft:copper_ore"]           = true,
    ["minecraft:deepslate_copper_ore"] = true,
    ["minecraft:raw_copper"]           = true,
    ["minecraft:raw_copper_block"]     = true,
    ["minecraft:copper_ingot"]         = true,
    ["minecraft:copper_block"]         = true,
}

-- Other things worth veining and never throwing away
local VALUABLE = {
    ["minecraft:diamond_ore"] = true, ["minecraft:deepslate_diamond_ore"] = true,
    ["minecraft:gold_ore"]    = true, ["minecraft:deepslate_gold_ore"]    = true,
    ["minecraft:iron_ore"]    = true, ["minecraft:deepslate_iron_ore"]    = true,
    ["minecraft:redstone_ore"]= true, ["minecraft:deepslate_redstone_ore"]= true,
    ["minecraft:lapis_ore"]   = true, ["minecraft:deepslate_lapis_ore"]   = true,
    ["minecraft:emerald_ore"] = true, ["minecraft:deepslate_emerald_ore"] = true,
    ["minecraft:coal_ore"]    = true, ["minecraft:deepslate_coal_ore"]    = true,
    ["minecraft:ancient_debris"] = true,
    ["minecraft:diamond"] = true, ["minecraft:raw_gold"] = true,
    ["minecraft:raw_iron"] = true, ["minecraft:redstone"] = true,
    ["minecraft:lapis_lazuli"] = true, ["minecraft:emerald"] = true,
}

local JUNK = {
    ["minecraft:cobblestone"] = true, ["minecraft:cobbled_deepslate"] = true,
    ["minecraft:stone"] = true, ["minecraft:deepslate"] = true,
    ["minecraft:dirt"] = true, ["minecraft:gravel"] = true,
    ["minecraft:granite"] = true, ["minecraft:diorite"] = true,
    ["minecraft:andesite"] = true, ["minecraft:tuff"] = true,
    ["minecraft:sand"] = true, ["minecraft:flint"] = true,
    ["minecraft:netherrack"] = true, ["minecraft:calcite"] = true,
    ["minecraft:smooth_basalt"] = true, ["minecraft:basalt"] = true,
    ["minecraft:blackstone"] = true, ["minecraft:rotten_flesh"] = true,
}

local FUEL = {
    ["minecraft:coal"] = true, ["minecraft:charcoal"] = true,
    ["minecraft:coal_block"] = true, ["minecraft:lava_bucket"] = true,
    ["minecraft:blaze_rod"] = true, ["minecraft:dried_kelp_block"] = true,
}

------------------------------- STATE ---------------------------------
local pos     = { x = 0, y = DEFAULT_Y, z = 0 }
local dir     = 0                     -- 0=N(-z) 1=E(+x) 2=S(+z) 3=W(-x)
local home    = { x = 0, y = DEFAULT_Y, z = 0 }
local homeDir = 0
local hasGPS  = false

local status      = "Idle"
local detail      = ""
local copperMined = 0
local otherMined  = 0
local blocksMoved = 0
local progress    = 0
local progressMax = 0
local curRow      = 0
local totalRows   = 0
local abortFlag   = false
local recallFlag  = false
local lastReport  = 0

local DELTA = {
    [0] = { x =  0, z = -1 },
    [1] = { x =  1, z =  0 },
    [2] = { x =  0, z =  1 },
    [3] = { x = -1, z =  0 },
}
local DIRNAME = { [0] = "north", [1] = "east", [2] = "south", [3] = "west" }

--------------------------- SMALL HELPERS -----------------------------
local function fuel()
    local f = turtle.getFuelLevel()
    if f == "unlimited" then return math.huge end
    return f
end

local function fuelMax()
    local f = turtle.getFuelLimit()
    if f == "unlimited" then return math.huge end
    return f
end

local function slotsUsed()
    local n = 0
    for i = 1, 16 do
        if turtle.getItemCount(i) > 0 then n = n + 1 end
    end
    return n
end

local function distanceHome()
    return math.abs(pos.x - home.x) + math.abs(pos.y - home.y) + math.abs(pos.z - home.z)
end

------------------------------ TELEMETRY ------------------------------
local function report(newStatus, newDetail, force)
    if newStatus then status = newStatus end
    if newDetail ~= nil then detail = newDetail end

    local now = os.clock()
    if not force and (now - lastReport) < REPORT_RATE then return end
    lastReport = now

    local f, fm = fuel(), fuelMax()
    rednet.broadcast({
        kind        = "TELEMETRY",
        id          = os.getComputerID(),
        status      = status,
        detail      = detail,
        x = pos.x, y = pos.y, z = pos.z,
        facing      = DIRNAME[dir],
        home        = { x = home.x, y = home.y, z = home.z },
        distHome    = distanceHome(),
        fuel        = (f  == math.huge) and -1 or f,
        fuelMax     = (fm == math.huge) and -1 or fm,
        copper      = copperMined,
        ores        = otherMined,
        slots       = slotsUsed(),
        moved       = blocksMoved,
        progress    = progress,
        progressMax = progressMax,
        row         = curRow,
        rows        = totalRows,
        gps         = hasGPS,
    }, PROTOCOL)
end

-- Telemetry/commands are best-effort; walking out of modem range never
-- stops the job, so the turtle keeps mining fully unattended.
local function pollCommands()
    local _, msg = rednet.receive(PROTOCOL, 0)
    if type(msg) == "table" then
        if msg.command == "ABORT" then
            abortFlag = true
        elseif msg.command == "RECALL" then
            recallFlag = true
        end
    end
end

------------------------------ REFUELLING -----------------------------
local function refuelFromInventory(target)
    local before = fuel()
    for i = 1, 16 do
        if fuel() >= target then break end
        local item = turtle.getItemDetail(i)
        if item and FUEL[item.name] then
            turtle.select(i)
            turtle.refuel()
        end
    end
    turtle.select(1)
    return fuel() > before
end

-- Enough fuel for one more move AND the whole trip home?
local function fuelOK(extra)
    if fuel() == math.huge then return true end
    local needed = distanceHome() + FUEL_RESERVE + (extra or 1)
    if fuel() >= needed then return true end
    refuelFromInventory(needed)
    return fuel() >= needed
end

------------------------------- MOVEMENT ------------------------------
-- Every move funnels through here so position tracking never drifts.
local function stepForward()
    if turtle.forward() then
        pos.x = pos.x + DELTA[dir].x
        pos.z = pos.z + DELTA[dir].z
        blocksMoved = blocksMoved + 1
        return true
    end
    return false
end

local function turnRight()
    turtle.turnRight()
    dir = (dir + 1) % 4
end

local function turnLeft()
    turtle.turnLeft()
    dir = (dir + 3) % 4
end

local function face(target)
    local diff = (target - dir) % 4
    if diff == 1 then turnRight()
    elseif diff == 2 then turnRight(); turnRight()
    elseif diff == 3 then turnLeft() end
end

-- Returns false if permanently blocked (bedrock / claim / no fuel).
local function forward(allowDig)
    if not fuelOK(1) then
        report("LOW FUEL", "cannot move", true)
        return false
    end
    for attempt = 1, DIG_RETRIES do
        if stepForward() then return true end
        if turtle.detect() then
            if not (allowDig ~= false and turtle.dig()) then
                if attempt >= 3 then return false end
            end
        else
            turtle.attack()
        end
        os.sleep(0.2)
    end
    return false
end

local function up(allowDig)
    if not fuelOK(1) then return false end
    for attempt = 1, DIG_RETRIES do
        if turtle.up() then
            pos.y = pos.y + 1
            blocksMoved = blocksMoved + 1
            return true
        end
        if turtle.detectUp() then
            if not (allowDig ~= false and turtle.digUp()) then
                if attempt >= 3 then return false end
            end
        else
            turtle.attackUp()
        end
        os.sleep(0.2)
    end
    return false
end

local function down(allowDig)
    if not fuelOK(1) then return false end
    for attempt = 1, DIG_RETRIES do
        if turtle.down() then
            pos.y = pos.y - 1
            blocksMoved = blocksMoved + 1
            return true
        end
        if turtle.detectDown() then
            if not (allowDig ~= false and turtle.digDown()) then
                if attempt >= 3 then return false end
            end
        else
            turtle.attackDown()
        end
        os.sleep(0.2)
    end
    return false
end

--------------------------- INVENTORY LOGIC ---------------------------
local function countMined(name)
    if COPPER[name] then
        copperMined = copperMined + 1
    else
        otherMined = otherMined + 1
    end
end

-- Squash partial stacks together to free up slots.
local function compact()
    for i = 16, 2, -1 do
        local a = turtle.getItemDetail(i)
        if a then
            for j = 1, i - 1 do
                local b = turtle.getItemDetail(j)
                if b and b.name == a.name and turtle.getItemSpace(j) > 0 then
                    turtle.select(i)
                    turtle.transferTo(j)
                    if turtle.getItemCount(i) == 0 then break end
                end
            end
        end
    end
    turtle.select(1)
end

-- Throw away worthless stone so the good stuff always has room.
local function dumpJunk()
    local dropped = 0
    for i = 1, 16 do
        local item = turtle.getItemDetail(i)
        if item and JUNK[item.name] and not COPPER[item.name] then
            turtle.select(i)
            turtle.digDown()
            turtle.dropDown()
            dropped = dropped + 1
        end
    end
    turtle.select(1)
    return dropped
end

-- Unload everything except fuel into a chest (front first, then below).
local function unload()
    report("Unloading", "sorting output", true)
    for i = 1, 16 do
        local item = turtle.getItemDetail(i)
        if item and not FUEL[item.name] then
            turtle.select(i)
            if not turtle.drop() then turtle.dropDown() end
        end
    end
    turtle.select(1)
end

--------------------------- COPPER DETECTION --------------------------
local function scan(inspectFn)
    local ok, data = inspectFn()
    if ok and data and data.name then return data.name end
    return nil
end

local function isOre(name)
    return name ~= nil and (COPPER[name] or VALUABLE[name]) or false
end

--------------------------- VEIN MINING -------------------------------
-- Follows a vein in 3D and always walks itself back out.
local veinBudget = 0
local veinMine

veinMine = function(depth)
    if veinBudget <= 0 or depth <= 0 or abortFlag then return end
    local entryDir = dir

    local n = scan(turtle.inspectUp)
    if isOre(n) then
        countMined(n); veinBudget = veinBudget - 1
        turtle.digUp()
        if up() then veinMine(depth - 1); down(false) end
    end

    n = scan(turtle.inspectDown)
    if isOre(n) then
        countMined(n); veinBudget = veinBudget - 1
        turtle.digDown()
        if down() then veinMine(depth - 1); up(false) end
    end

    for _ = 1, 4 do
        if veinBudget <= 0 or abortFlag then break end
        n = scan(turtle.inspect)
        if isOre(n) then
            countMined(n); veinBudget = veinBudget - 1
            turtle.dig()
            local stepDir = dir
            if forward() then
                report("Vein mining", "node " .. (MAX_VEIN - veinBudget))
                veinMine(depth - 1)
                -- A deeper call can bail out mid-turn, so re-aim before backing out.
                face(stepDir)
                turnRight(); turnRight()
                forward(false)
                face(stepDir)
            end
        end
        turnRight()
    end
    face(entryDir)
end

-- Only the three faces the turtle can already see are probed. Spinning a full
-- circle on every block to look sideways was the constant twirling, and in a
-- solid room those side blocks get mined by the next lane anyway.
local function checkVein()
    if not (isOre(scan(turtle.inspectUp))
         or isOre(scan(turtle.inspectDown))
         or isOre(scan(turtle.inspect))) then
        return
    end

    veinBudget = MAX_VEIN
    local startDir = dir
    veinMine(12)
    face(startDir)
end

----------------------------- NAVIGATION ------------------------------
-- Set while walking home so an abort/recall cannot cancel the trip back.
local returning = false

local function stopNav()
    return abortFlag and not returning
end

local function goToY(targetY)
    while pos.y ~= targetY do
        if stopNav() then return false end
        report("Changing depth", "Y " .. pos.y .. " -> " .. targetY)
        local moved = (pos.y < targetY) and up() or down()
        if not moved then
            if not forward() then return false end -- sidestep the obstruction
        end
        pollCommands()
    end
    return true
end

local function goToXZ(tx, tz)
    while pos.x ~= tx do
        if stopNav() then return false end
        face(pos.x < tx and 1 or 3)
        report("Travelling", "X " .. pos.x .. " -> " .. tx)
        if not forward() then
            if not up() then return false end
        end
        pollCommands()
    end
    while pos.z ~= tz do
        if stopNav() then return false end
        face(pos.z < tz and 2 or 0)
        report("Travelling", "Z " .. pos.z .. " -> " .. tz)
        if not forward() then
            if not up() then return false end
        end
        pollCommands()
    end
    return true
end

local function goHome()
    returning = true
    report("RETURNING HOME", distanceHome() .. " blocks out", true)
    if pos.y < home.y then goToY(home.y) end   -- climb first to clear terrain
    goToXZ(home.x, home.z)
    goToY(home.y)
    face(homeDir)
    returning = false
    report("HOME", "arrived", true)
end

------------------------------ MAIN JOB -------------------------------
-- Any reason to break off the pattern and head home right now?
local function shouldStop()
    if abortFlag then
        report("ABORTED", "by operator", true)
        return true
    end
    if recallFlag then
        report("RECALLED", "operator recall", true)
        return true
    end
    -- Fuel guard: this is what used to strand the turtle mid-tunnel.
    if not fuelOK(4) then
        report("LOW FUEL", "returning early", true)
        return true
    end
    if slotsUsed() >= 14 then
        compact()
        if slotsUsed() >= 14 then dumpJunk() end
        if slotsUsed() >= 16 then
            report("FULL", "inventory full, going home", true)
            return true
        end
    end
    return false
end

local function mineRow(length, rowIndex, rows)
    for i = 1, length do
        pollCommands()
        if shouldStop() then return false end

        progress = progress + 1
        report("Mining", "lane " .. rowIndex .. "/" .. rows .. "  " .. i .. "/" .. length)

        if not forward() then
            report("BLOCKED", "unbreakable block ahead", true)
            return false
        end
        turtle.digUp()
        turtle.digDown()
        checkVein()
    end
    return true
end

-- Hollows out a solid rectangle: adjacent lanes with no gap between them,
-- each lane 3 blocks tall (floor, body, ceiling).
local function mineRoom(length, width)
    progress, progressMax = 0, length * width
    curRow, totalRows = 1, width

    for r = 1, width do
        curRow = r
        if not mineRow(length, r, width) then return end

        if r < width then
            report("Shifting", "to lane " .. (r + 1), true)
            local turn = (r % 2 == 1) and turnRight or turnLeft
            turn()
            if shouldStop() then return end
            if not forward() then
                report("BLOCKED", "cannot reach next lane", true)
                return
            end
            turtle.digUp()
            turtle.digDown()
            turn()
        end
    end
    report("Room complete", width .. " x " .. length, true)
end

------------------------------ BOOTSTRAP ------------------------------
local function locate()
    local x, y, z = gps.locate(2)
    if x then
        pos.x, pos.y, pos.z = math.floor(x), math.floor(y), math.floor(z)
        hasGPS = true
        return true
    end
    hasGPS = false
    return false
end

if peripheral.getType(MODEM_SIDE) ~= "modem" then
    for _, side in ipairs({ "right", "left", "top", "bottom", "front", "back" }) do
        if peripheral.getType(side) == "modem" then MODEM_SIDE = side break end
    end
end
rednet.open(MODEM_SIDE)

term.clear()
term.setCursorPos(1, 1)
print("=== COPPER MINING NODE ===")
print("Turtle ID : " .. os.getComputerID())
print("Modem     : " .. MODEM_SIDE)
locate()
print("GPS       : " .. (hasGPS and (pos.x .. "," .. pos.y .. "," .. pos.z) or "none (dead reckoning)"))
print("Fuel      : " .. tostring(turtle.getFuelLevel()))
print("Waiting for controller...")

while true do
    local _, msg = rednet.receive(PROTOCOL)
    if type(msg) == "table" and msg.command == "START_MINE" then
        abortFlag, recallFlag = false, false
        copperMined, otherMined, blocksMoved = 0, 0, 0

        if not locate() then
            pos.x, pos.z = 0, 0
            pos.y = tonumber(msg.startY) or DEFAULT_Y
        end
        dir     = tonumber(msg.facing) or 0
        home    = { x = pos.x, y = pos.y, z = pos.z }
        homeDir = dir

        local targetY = tonumber(msg.targetY) or DEFAULT_Y
        local length  = math.max(1, tonumber(msg.length) or 20)
        local width   = math.max(1, tonumber(msg.width) or 1)

        report("Starting", "home locked in", true)
        refuelFromInventory(length * width * 2 + width + FUEL_RESERVE)

        goToY(targetY)
        if not abortFlag then mineRoom(length, width) end

        -- Always walk back to the exact starting block, whatever happened.
        goHome()
        unload()
        report("FINISHED", copperMined .. " copper recovered", true)
    elseif type(msg) == "table" and msg.command == "PING" then
        report(nil, nil, true)
    end
end
