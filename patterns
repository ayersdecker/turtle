local DISPLAY_SIDE = "top"
local BOARD_BLOCK_WIDTH = 9
local BOARD_BLOCK_HEIGHT = 4
local WIDTH = math.floor((BOARD_BLOCK_WIDTH * 16 - 2) / 3.5)
local HEIGHT = BOARD_BLOCK_HEIGHT * 2
local PATTERN_HEIGHT = HEIGHT - 1
local FOOTER_TEXT = "visit www.deckerayers.com"
local FRAME_SECONDS = 0.18

local function attachedPeripherals()
	local names = peripheral.getNames()
	local attached = {}

	for i, name in ipairs(names) do
		attached[i] = name .. " (" .. peripheral.getType(name) .. ")"
	end

	return table.concat(attached, ", ")
end

local display = peripheral.wrap(DISPLAY_SIDE)

if not display then
	error("No Display Link on " .. DISPLAY_SIDE .. ". Attached peripherals: " .. attachedPeripherals())
end

local function hasMethod(name)
	return type(display[name]) == "function"
end

local function methodList()
	local methods = {}

	for name, value in pairs(display) do
		if type(value) == "function" then
			methods[#methods + 1] = name
		end
	end

	table.sort(methods)
	return table.concat(methods, ", ")
end

local function fit(text)
	text = tostring(text or "")

	if #text > WIDTH then
		return string.sub(text, 1, WIDTH)
	end

	return text .. string.rep(" ", WIDTH - #text)
end

local function clearDisplay()
	if hasMethod("clear") then
		display.clear()
	end
end

local function writeLine(line, text)
	text = fit(text)

	if hasMethod("setCursorPos") and hasMethod("clearLine") and hasMethod("write") then
		display.setCursorPos(1, line)
		display.clearLine()
		display.write(text)
		return
	end

	if hasMethod("setLine") then
		display.setLine(line, text)
		return
	end

	if hasMethod("write") then
		display.write(text)
		display.write("\n")
		return
	end

	error("Display has no supported write method. Methods: " .. methodList())
end

local function flushDisplay()
	if hasMethod("update") then
		display.update()
	elseif hasMethod("push") then
		display.push()
	end
end

local function draw(lines)
	clearDisplay()

	for y = 1, PATTERN_HEIGHT do
		writeLine(y, lines[y] or "")
	end

	writeLine(HEIGHT, FOOTER_TEXT)

	flushDisplay()
end

local function makeCanvas(fill)
	local canvas = {}
	fill = fill or " "

	for y = 1, HEIGHT do
		canvas[y] = {}

		for x = 1, WIDTH do
			canvas[y][x] = fill
		end
	end

	return canvas
end

local function setChar(canvas, x, y, char)
	if x < 1 or x > WIDTH or y < 1 or y > HEIGHT then
		return
	end

	if char ~= " " then
		canvas[y][x] = char
	end
end

local function putText(canvas, x, y, text)
	for i = 1, #text do
		setChar(canvas, x + i - 1, y, string.sub(text, i, i))
	end
end

local function putSprite(canvas, x, y, sprite)
	for row = 1, #sprite do
		local line = sprite[row]

		for col = 1, #line do
			setChar(canvas, x + col - 1, y + row - 1, string.sub(line, col, col))
		end
	end
end

local function canvasLines(canvas)
	local lines = {}

	for y = 1, HEIGHT do
		lines[y] = table.concat(canvas[y])
	end

	return lines
end

local function patternLines(frame, palette, pattern)
	local canvas = makeCanvas(" ")

	for row = 1, PATTERN_HEIGHT do
		for column = 1, WIDTH do
			local value = pattern(column, row, frame)
			setChar(canvas, column, row, palette[(value % #palette) + 1])
		end
	end

	return canvasLines(canvas)
end

local function sceneSlashes(frame)
	return patternLines(frame, { "/", "/", " ", "\\", "\\", " " }, function(column, row, tick)
		return math.floor((column + row * 2 + tick) / 2)
	end)
end

local function sceneBlocks(frame)
	return patternLines(frame, { "#", "#", " ", " ", "+", "." }, function(column, row, tick)
		return math.floor((column + tick) / 4) + math.floor(row / 2)
	end)
end

local function sceneDiamonds(frame)
	local centerColumn = math.floor(WIDTH / 2)
	local centerRow = math.floor(PATTERN_HEIGHT / 2) + 1

	return patternLines(frame, { "#", "*", "+", ".", " ", ".", "+", "*" }, function(column, row, tick)
		return math.abs(column - centerColumn) + math.abs((row - centerRow) * 3) + tick
	end)
end

local function sceneRings(frame)
	local centerColumn = math.floor(WIDTH / 2)
	local centerRow = math.floor(PATTERN_HEIGHT / 2) + 1

	return patternLines(frame, { "@", "O", "o", ".", " ", ".", "o", "O" }, function(column, row, tick)
		local dx = math.abs(column - centerColumn)
		local dy = math.abs(row - centerRow) * 4
		return math.floor((dx * dx + dy * dy) / 9) + tick
	end)
end

local function sceneColumns(frame)
	return patternLines(frame, { "|", "|", ":", ".", " ", ".", ":" }, function(column, row, tick)
		return math.abs(((column + tick) % 10) - 5) + row
	end)
end

local function sceneRows(frame)
	return patternLines(frame, { "=", "=", "-", ".", " ", ".", "-" }, function(column, row, tick)
		return math.abs(((row * 3 + tick) % 12) - 6) + math.floor(column / 6)
	end)
end

local function sceneStatic(frame)
	return patternLines(frame, { "#", "*", "+", ".", " ", " ", ".", "+" }, function(column, row, tick)
		return column * 23 + row * 41 + tick * 17 + column * row
	end)
end

local function sceneDrips(frame)
	return patternLines(frame, { "|", ":", ".", " ", " ", " " }, function(column, row, tick)
		return column * 7 + math.floor((row * 5 + tick + column) / 2)
	end)
end

local function sceneVortex(frame)
	local centerColumn = math.floor(WIDTH / 2)
	local centerRow = math.floor(PATTERN_HEIGHT / 2) + 1

	return patternLines(frame, { "@", "#", "*", "+", ".", " ", ".", "+" }, function(column, row, tick)
		local dx = column - centerColumn
		local dy = (row - centerRow) * 5
		return math.abs(dx * dy) + math.abs(dx) + tick
	end)
end

local function sceneZigZags(frame)
	return patternLines(frame, { "/", "-", "_", "\\", "_", "-" }, function(column, row, tick)
		return math.abs(((column + tick) % 16) - row * 2)
	end)
end

local function sceneStars(frame)
	return patternLines(frame, { "*", "+", ".", " ", " ", " ", " " }, function(column, row, tick)
		return column * 13 + row * 29 + tick * tick + column * row
	end)
end

local function sceneRipples(frame)
	local centerColumn = 1 + (frame % WIDTH)
	local centerRow = 1 + (math.floor(frame / 4) % PATTERN_HEIGHT)

	return patternLines(frame, { "O", "o", ".", " ", ".", "o" }, function(column, row, tick)
		return math.abs(column - centerColumn) + math.abs(row - centerRow) * 3 + tick
	end)
end

local function sceneChevrons(frame)
	return patternLines(frame, { ">", ">", "-", " ", "<", "<", "-", " " }, function(column, row, tick)
		return math.abs(((column + tick) % 12) - row)
	end)
end

local function sceneCrosshatch(frame)
	return patternLines(frame, { "X", "/", "\\", "+", ".", " " }, function(column, row, tick)
		return math.abs(((column + tick) % 9) - ((row * 2) % 9)) + math.abs(((column - tick) % 11) - row)
	end)
end

local function sceneCurtain(frame)
	return patternLines(frame, { "#", "=", "-", ".", " ", ".", "-", "=" }, function(column, row, tick)
		return math.abs(((column + tick) % WIDTH) - WIDTH / 2) + row * 2
	end)
end

local function sceneShutters(frame)
	return patternLines(frame, { "#", "#", "=", "-", ".", " " }, function(column, row, tick)
		return math.abs(((row * 2 + tick) % 14) - 7) + math.floor(column / 3)
	end)
end

local function sceneComets(frame)
	local canvas = makeCanvas(".")

	for index = 1, 10 do
		local column = ((frame * 2 + index * 13) % (WIDTH + 12)) - 6
		local row = ((index * 5 + frame) % PATTERN_HEIGHT) + 1
		putSprite(canvas, column, row, { "***---..." })
	end

	return canvasLines(canvas)
end

local function sceneGrid(frame)
	return patternLines(frame, { "+", "-", "|", ".", " " }, function(column, row, tick)
		if (column + tick) % 7 == 0 or (row * 2 + tick) % 6 == 0 then
			return 0
		end

		return column + row + tick
	end)
end

local function sceneBubbles(frame)
	local canvas = makeCanvas(" ")

	for index = 1, 24 do
		local column = ((index * 11 + frame) % WIDTH) + 1
		local row = PATTERN_HEIGHT - ((frame + index * 3) % PATTERN_HEIGHT)
		local bubble = (index + frame) % 3 == 0 and "O" or "o"
		setChar(canvas, column, row, bubble)
	end

	for row = PATTERN_HEIGHT - 1, PATTERN_HEIGHT do
		for column = 1, WIDTH do
			setChar(canvas, column, row, (column + frame) % 3 == 0 and "~" or ".")
		end
	end

	return canvasLines(canvas)
end

local function sceneMaze(frame)
	return patternLines(frame, { "#", "#", " ", " ", ".", "+" }, function(column, row, tick)
		return math.floor((column + tick) / 4) + math.floor((row * 3 + tick) / 3) + column * row
	end)
end

local scenes = {
	sceneSlashes,
	sceneBlocks,
	sceneDiamonds,
	sceneRings,
	sceneColumns,
	sceneRows,
	sceneStatic,
	sceneDrips,
	sceneVortex,
	sceneZigZags,
	sceneStars,
	sceneRipples,
	sceneChevrons,
	sceneCrosshatch,
	sceneCurtain,
	sceneShutters,
	sceneComets,
	sceneGrid,
	sceneBubbles,
	sceneMaze,
}

print("Running display patterns on " .. WIDTH .. "x" .. HEIGHT .. " board...")

local frame = 0

while true do
	local scene = scenes[(math.floor(frame / 36) % #scenes) + 1]
	draw(scene(frame))
	frame = frame + 1
	sleep(FRAME_SECONDS)
end