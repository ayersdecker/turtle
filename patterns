local DISPLAY_SIDE = "top"
local BOARD_BLOCK_WIDTH = 9
local BOARD_BLOCK_HEIGHT = 4
local WIDTH = math.floor((BOARD_BLOCK_WIDTH * 16 - 2) / 3.5)
local HEIGHT = BOARD_BLOCK_HEIGHT * 2
local FRAME_SECONDS = 0.18

local function attachedPeripherals()
	local names = peripheral.getNames()
	local attached = {}

	for i, name in ipairs(names) do
		attached[i] = name .. " (" .. peripheral.getType(name) .. ")"
	end

	return table.concat(attached, ", ")
end

local display = peripheral.wrap(DISPLAY_SIDE)

if not display then
	error("No Display Link on " .. DISPLAY_SIDE .. ". Attached peripherals: " .. attachedPeripherals())
end

local function hasMethod(name)
	return type(display[name]) == "function"
end

local function methodList()
	local methods = {}

	for name, value in pairs(display) do
		if type(value) == "function" then
			methods[#methods + 1] = name
		end
	end

	table.sort(methods)
	return table.concat(methods, ", ")
end

local function fit(text)
	text = tostring(text or "")

	if #text > WIDTH then
		return string.sub(text, 1, WIDTH)
	end

	return text .. string.rep(" ", WIDTH - #text)
end

local function clearDisplay()
	if hasMethod("clear") then
		display.clear()
	end
end

local function writeLine(line, text)
	text = fit(text)

	if hasMethod("setCursorPos") and hasMethod("clearLine") and hasMethod("write") then
		display.setCursorPos(1, line)
		display.clearLine()
		display.write(text)
		return
	end

	if hasMethod("setLine") then
		display.setLine(line, text)
		return
	end

	if hasMethod("write") then
		display.write(text)
		display.write("\n")
		return
	end

	error("Display has no supported write method. Methods: " .. methodList())
end

local function flushDisplay()
	if hasMethod("update") then
		display.update()
	elseif hasMethod("push") then
		display.push()
	end
end

local function draw(lines)
	clearDisplay()

	for y = 1, HEIGHT do
		writeLine(y, lines[y] or "")
	end

	flushDisplay()
end

local function makeCanvas(fill)
	local canvas = {}
	fill = fill or " "

	for y = 1, HEIGHT do
		canvas[y] = {}

		for x = 1, WIDTH do
			canvas[y][x] = fill
		end
	end

	return canvas
end

local function setChar(canvas, x, y, char)
	if x < 1 or x > WIDTH or y < 1 or y > HEIGHT then
		return
	end

	if char ~= " " then
		canvas[y][x] = char
	end
end

local function putText(canvas, x, y, text)
	for i = 1, #text do
		setChar(canvas, x + i - 1, y, string.sub(text, i, i))
	end
end

local function putSprite(canvas, x, y, sprite)
	for row = 1, #sprite do
		local line = sprite[row]

		for col = 1, #line do
			setChar(canvas, x + col - 1, y + row - 1, string.sub(line, col, col))
		end
	end
end

local function canvasLines(canvas)
	local lines = {}

	for y = 1, HEIGHT do
		lines[y] = table.concat(canvas[y])
	end

	return lines
end

local function sceneDino(frame)
	local canvas = makeCanvas(" ")
	local ground = HEIGHT - 1
	local dinoY = ground - 3
	local legFrame = frame % 4 < 2
	local dino = legFrame and {
		"  __ ",
		" /oo|",
		"/|__ ",
		" /  \\",
	} or {
		"  __ ",
		" /oo|",
		"/|__ ",
		" \\  /",
	}

	putText(canvas, 2, 1, "NO INTERNET?  DINO RUN")

	for x = 1, WIDTH do
		setChar(canvas, x, ground, x % 2 == frame % 2 and "_" or "-")
	end

	putSprite(canvas, 4, dinoY, dino)

	for i = 0, 2 do
		local cactusX = WIDTH - ((frame * 2 + i * 15) % (WIDTH + 12))
		putSprite(canvas, cactusX, ground - 2, { " | ", "-|-", " | " })
	end

	local cloudX = WIDTH - ((frame + 5) % (WIDTH + 10))
	putSprite(canvas, cloudX, 2, { " .--. ", "(____)" })
	return canvasLines(canvas)
end

local function sceneMoonLanding(frame)
	local canvas = makeCanvas(" ")
	local shipX = WIDTH - ((frame * 2) % (WIDTH + 10))
	local shipY = 2 + math.floor((frame % 16) / 6)

	putText(canvas, 2, 1, "APOLLO FEED // LOW ORBIT")
	putSprite(canvas, shipX, shipY, { " /\\", "|==>", " \\/" })

	for i = 1, 12 do
		local starX = ((i * 11 + frame) % WIDTH) + 1
		local starY = ((i * 7) % 5) + 2
		setChar(canvas, starX, starY, i % 3 == 0 and "+" or ".")
	end

	putText(canvas, 1, HEIGHT - 1, "__..---..____..---..____..---..__")
	putText(canvas, 5, HEIGHT, "MOON CAM 1969  SIGNAL: LOCKED")
	return canvasLines(canvas)
end

local function sceneCityTrain(frame)
	local canvas = makeCanvas(" ")
	local trainX = WIDTH - ((frame * 2) % (WIDTH + 28))

	putText(canvas, 1, 1, "NIGHT TRAIN ARRIVING PLATFORM 4")
	putText(canvas, 1, 2, "[]  []  []   []  []   []  []   []")
	putText(canvas, 1, 3, " |  |   |     |  |    |   |    |")
	putSprite(canvas, trainX, 4, {
		" ________________________ ",
		"| [] [] [] [] [] [] []  |",
		"|________________________|",
		"  o  o  o  o  o  o  o   ",
	})

	return canvasLines(canvas)
end

local function sceneOcean(frame)
	local canvas = makeCanvas(" ")
	local sunX = 6 + math.floor((frame % 28) / 2)

	putText(canvas, sunX, 2, "\\ | /")
	putText(canvas, sunX + 1, 3, "-O-")
	putText(canvas, sunX, 4, "/ | \\")

	for y = 5, HEIGHT do
		local wave = (frame + y) % 4
		local line = string.sub("~~~~____~~~~____~~~~____~~~~____~~~~____", wave + 1, wave + WIDTH)
		putText(canvas, 1, y, line)
	end

	putText(canvas, 2, 1, "SUNSET LOOP // DISPLAY BOARD TV")
	return canvasLines(canvas)
end

local function sceneLoading(frame)
	local canvas = makeCanvas(" ")
	local barWidth = WIDTH - 8
	local progress = frame % (barWidth + 1)

	putText(canvas, 7, 2, "GOOGLE-ISH LOADING")
	putText(canvas, 4, 4, "+" .. string.rep("-", barWidth) .. "+")
	putText(canvas, 4, 5, "|" .. string.rep("#", progress) .. string.rep(" ", barWidth - progress) .. "|")
	putText(canvas, 4, 6, "+" .. string.rep("-", barWidth) .. "+")
	putText(canvas, 9, 8, "PLEASE WAIT " .. string.sub("....", 1, (frame % 4) + 1))
	return canvasLines(canvas)
end

local scenes = {
	sceneDino,
	sceneMoonLanding,
	sceneCityTrain,
	sceneOcean,
	sceneLoading,
}

print("Running display patterns on " .. WIDTH .. "x" .. HEIGHT .. " board...")

local frame = 0

while true do
	local scene = scenes[(math.floor(frame / 36) % #scenes) + 1]
	draw(scene(frame))
	frame = frame + 1
	sleep(FRAME_SECONDS)
end