local DISPLAY_SIDE = "top"
local WIDTH = 40
local HEIGHT = 8
local REFRESH_SECONDS = 1
local SEASON_LENGTH = 28

local SEASONS = { "Spring", "Summer", "Autumn", "Winter" }
local MOON_PHASES = {
	"Full moon", "Waning gibbous", "Third quarter", "Waning crescent",
	"New moon", "Waxing crescent", "First quarter", "Waxing gibbous",
}

local function attachedPeripherals()
	local attached = {}

	for _, name in ipairs(peripheral.getNames()) do
		attached[#attached + 1] = name .. " (" .. peripheral.getType(name) .. ")"
	end

	return table.concat(attached, ", ")
end

local display = peripheral.wrap(DISPLAY_SIDE)

if not display then
	error("No display found on " .. DISPLAY_SIDE .. ". Attached peripherals: " .. attachedPeripherals())
end

local function hasMethod(name)
	return type(display[name]) == "function"
end

local function fit(text)
	text = tostring(text or "")
	if #text > WIDTH then
		return string.sub(text, 1, WIDTH)
	end
	return text .. string.rep(" ", WIDTH - #text)
end

local function writeLine(line, text)
	text = fit(text)

	if hasMethod("setCursorPos") and hasMethod("clearLine") and hasMethod("write") then
		display.setCursorPos(1, line)
		display.clearLine()
		display.write(text)
	elseif hasMethod("setLine") then
		display.setLine(line, text)
	elseif hasMethod("write") then
		display.write(text .. "\n")
	else
		error("Display has no supported write method")
	end
end

local function draw(lines)
	if hasMethod("clear") then
		display.clear()
	end

	for line = 1, HEIGHT do
		writeLine(line, lines[line] or "")
	end

	if hasMethod("update") then
		display.update()
	elseif hasMethod("push") then
		display.push()
	end
end

local function locate()
	if type(gps) ~= "table" or type(gps.locate) ~= "function" then
		return "GPS unavailable"
	end

	local ok, x, y, z = pcall(gps.locate, 1)
	if not ok or not x then
		return "GPS unavailable"
	end

	return string.format("GPS %d,%d,%d", math.floor(x), math.floor(y), math.floor(z))
end

local function statusLines()
	local day = os.day()
	local time = os.time()
	local seasonIndex = (math.floor(day / SEASON_LENGTH) % #SEASONS) + 1
	local moonIndex = (day % #MOON_PHASES) + 1
	local label = os.getComputerLabel() or "Unlabelled"

	return {
		"SERVER STATUS  " .. string.format("Day %d", day),
		"Time " .. textutils.formatTime(time, true) .. "  " .. SEASONS[seasonIndex],
		"Moon: " .. MOON_PHASES[moonIndex],
		locate(),
		"Computer #" .. os.getComputerID() .. "  " .. label,
		"Uptime " .. string.format("%dm %02ds", math.floor(os.clock() / 60), math.floor(os.clock() % 60)),
		"Season length: " .. SEASON_LENGTH .. " days",
		"Refresh: " .. REFRESH_SECONDS .. "s",
	}
end

while true do
	draw(statusLines())
	sleep(REFRESH_SECONDS)
end