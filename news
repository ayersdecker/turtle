local DISPLAY_SIDE = "top"
local BOARD_BLOCK_WIDTH = 9
local BOARD_BLOCK_HEIGHT = 4
local BOARD_WIDTH = math.floor((BOARD_BLOCK_WIDTH * 16 - 2) / 3.5)
local BOARD_HEIGHT = BOARD_BLOCK_HEIGHT * 2
local INNER_WIDTH = BOARD_WIDTH - 2
local FEED_URL = "https://feeds.bbci.co.uk/news/rss.xml"
local REFRESH_SECONDS = 900
local STORY_SECONDS = 12
local FRAME_SECONDS = 1

local function attachedPeripherals()
	local names = peripheral.getNames()
	local attached = {}

	for i, name in ipairs(names) do
		attached[i] = name .. " (" .. peripheral.getType(name) .. ")"
	end

	return table.concat(attached, ", ")
end

local function findDisplay()
local top = peripheral.wrap(DISPLAY_SIDE)

if top then
return top
end

local found = peripheral.find("display_link") or peripheral.find("monitor")

if found then
return found
end

for _, name in ipairs(peripheral.getNames()) do
local device = peripheral.wrap(name)

if device and (type(device.setCursorPos) == "function" or type(device.setLine) == "function" or type(device.write) == "function") then
return device
end
end

return nil
end

local display = findDisplay()

if not display then
error("Display Link not found on " .. DISPLAY_SIDE .. ". Attached peripherals: " .. attachedPeripherals())
end

local function hasMethod(name)
return type(display[name]) == "function"
end

local function methodList()
local name = peripheral.getName and peripheral.getName(display)

if not name or not peripheral.getMethods then
return "unknown"
end

local methods = peripheral.getMethods(name) or {}
return table.concat(methods, ", ")
end

local function clearDisplay()
if hasMethod("clear") then
display.clear()
end
end

local function fitLine(text)
text = tostring(text or "")

if #text > BOARD_WIDTH then
return string.sub(text, 1, BOARD_WIDTH)
end

return text .. string.rep(" ", BOARD_WIDTH - #text)
end

local function fitField(text, width)
text = tostring(text or "")

if #text > width then
return string.sub(text, 1, width)
end

return text .. string.rep(" ", width - #text)
end

local function centerField(text, width)
text = tostring(text or "")

if #text > width then
return string.sub(text, 1, width)
end

local left = math.floor((width - #text) / 2)
local right = width - #text - left
return string.rep(" ", left) .. text .. string.rep(" ", right)
end

local function boxed(text)
return "|" .. fitField(text, INNER_WIDTH) .. "|"
end

local function writeLine(line, text)
text = fitLine(text)

if hasMethod("setCursorPos") and hasMethod("clearLine") and hasMethod("write") then
display.setCursorPos(1, line)
display.clearLine()
display.write(text)
return
end

if hasMethod("setLine") then
display.setLine(line, text)
return
end

if hasMethod("write") then
display.write(text)
display.write("\n")
return
end

error("Display has no supported write method. Methods: " .. methodList())
end

local function flushDisplay()
if hasMethod("update") then
display.update()
elseif hasMethod("push") then
display.push()
end
end

local function xmlDecode(text)
text = text:gsub("<!%[CDATA%[(.-)%]%]>", "%1")
text = text:gsub("&amp;", "&")
text = text:gsub("&quot;", "\"")
text = text:gsub("&apos;", "'")
text = text:gsub("&lt;", "<")
text = text:gsub("&gt;", ">")
return text
end

local function cleanText(text)
text = xmlDecode(text or "")
text = text:gsub("[^%w%p%s]", "")
text = text:gsub("%s+", " ")
text = text:gsub("^%s+", "")
text = text:gsub("%s+$", "")
return text
end

local function fetchFeed()
if not http then
return nil, "HTTP disabled"
end

local response, reason = http.get(FEED_URL)

if not response then
return nil, tostring(reason or "fetch failed")
end

local body = response.readAll()
response.close()
return body
end

local function parseHeadlines(body)
local headlines = {}

for item in body:gmatch("<item.->(.-)</item>") do
local title = item:match("<title>(.-)</title>")

if title then
headlines[#headlines + 1] = cleanText(title)
end
end

return headlines
end

local function fallbackHeadlines(reason)
return {
"BBC RSS unavailable",
"Check CC http",
tostring(reason or "try again later")
}
end

local function loadHeadlines()
local body, reason = fetchFeed()

if not body then
return fallbackHeadlines(reason)
end

local headlines = parseHeadlines(body)

if #headlines == 0 then
return fallbackHeadlines("no headlines")
end

return headlines
end

local function wrapText(text, width)
width = width or BOARD_WIDTH
local lines = {}
local current = ""

for word in text:gmatch("%S+") do
if #word > width then
if current ~= "" then
lines[#lines + 1] = current
current = ""
end

while #word > width do
lines[#lines + 1] = string.sub(word, 1, width)
word = string.sub(word, width + 1)
end
end

if current == "" then
current = word
elseif #current + 1 + #word <= width then
current = current .. " " .. word
else
lines[#lines + 1] = current
current = word
end
end

if current ~= "" then
lines[#lines + 1] = current
end

return lines
end

local function tickerWindow(text, offset)
local ticker = "   >>> " .. cleanText(text) .. "   "
local doubled = ticker .. ticker
offset = (offset % #ticker) + 1
return string.sub(doubled, offset, offset + INNER_WIDTH - 1)
end

local function timeStamp()
if os.date then
return os.date("%H:%M")
end

return "--:--"
end

local function drawHeadline(headline, storyIndex, storyCount, tickerText, tick)
local lines = wrapText(headline, INNER_WIDTH)
local border = "+" .. string.rep("-", INNER_WIDTH) .. "+"
local title = "BBC NEWS  |  LIVE " .. tostring(storyIndex) .. "/" .. tostring(storyCount) .. "  |  " .. timeStamp()
local pulse = (tick % 2 == 0) and "*" or " "

clearDisplay()
writeLine(1, border)
writeLine(2, "|" .. centerField(title, INNER_WIDTH) .. "|")
writeLine(3, "|" .. centerField(pulse .. " REAL WORLD HEADLINES " .. pulse, INNER_WIDTH) .. "|")
writeLine(4, border)
writeLine(5, boxed(lines[1] or ""))
writeLine(6, boxed(lines[2] or ""))
writeLine(7, "|" .. tickerWindow(tickerText, tick) .. "|")
writeLine(8, border)

flushDisplay()
end

print("Running real news loop...")

local headlines = loadHeadlines()
local lastRefresh = os.clock()

while true do
for i, headline in ipairs(headlines) do
if os.clock() - lastRefresh > REFRESH_SECONDS then
headlines = loadHeadlines()
lastRefresh = os.clock()
break
end

local nextHeadline = headlines[(i % #headlines) + 1] or headline

for tick = 0, STORY_SECONDS - 1 do
drawHeadline(headline, i, #headlines, nextHeadline, tick)
sleep(FRAME_SECONDS)
end
end
end
